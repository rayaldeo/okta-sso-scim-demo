# Copy to .env and fill in. .env is gitignored. Never commit real values.
# Real environment variables take precedence over values in .env.

# --- App ---
LISTEN_ADDR=:8080
# Public base URL of this app. Must match what you configure in Okta.
# Use https://<your-tunnel-or-azure-host> when Okta needs to reach SCIM.
BASE_URL=http://localhost:8080
DB_PATH=data/app.db
SESSION_TTL=8h

# --- Role mapping: Okta group name -> app role ---
ROLE_ADMIN_GROUP=app-admin
ROLE_VIEWER_GROUP=app-viewer

# --- OIDC (step 3) ---
# e.g. https://integrator-1234567.okta.com/oauth2/default
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- SAML (step 4) ---
# Okta app > Sign On tab > "Metadata URL"
SAML_IDP_METADATA_URL=
SAML_SP_CERT_FILE=certs/sp.crt
SAML_SP_KEY_FILE=certs/sp.key

# --- SCIM (step 5) ---
# Generate with:  go run ./cmd/gentoken
# At least 32 characters. Paste the same value into Okta's provisioning settings.
SCIM_BEARER_TOKEN=
